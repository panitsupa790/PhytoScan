{
  "augmentation": {
    "fill_mode": "reflect",
    "horizontal_flip": true,
    "interpolation": "bilinear",
    "rotation_degrees": 10.0,
    "translation_height_fraction": 0.05,
    "translation_width_fraction": 0.05,
    "zoom_fraction": 0.1
  },
  "class_weights": {
    "formula": "N / (number_of_classes * count_i)"
  },
  "classes": [
    "healthy",
    "leaf_spot",
    "mosaic_virus"
  ],
  "config_version": "1.0",
  "data": {
    "channels": 3,
    "expected_counts": {
      "test": 0,
      "train": 2425,
      "val": 324
    },
    "image_size": [
      224,
      224
    ],
    "manifest": "dataset/metadata/eggplant_split_manifest.csv",
    "split_root": "dataset/split/eggplant",
    "train_class_counts": {
      "healthy": 1039,
      "leaf_spot": 371,
      "mosaic_virus": 1015
    },
    "train_split": "train",
    "validation_split": "val"
  },
  "experiment_id": "eggplant_d9_refinement",
  "model": {
    "architecture": "EfficientNetB0",
    "backbone_layer_name": "efficientnetb0",
    "dropout_rate": 0.2,
    "feature_extractor_layer_name": "frozen_efficientnetb0_features",
    "freeze_batch_normalization": true,
    "head_layer_name": "classification_head",
    "output_classes": 3,
    "top_layer_window": 20
  },
  "runs": {
    "R1": {
      "augmentation": false,
      "class_weights": false,
      "directory": "R1_finetune",
      "technique": "Fine-tuning"
    },
    "R2": {
      "augmentation": false,
      "class_weights": true,
      "directory": "R2_class_weight",
      "technique": "Fine-tuning + class weights"
    },
    "R3": {
      "augmentation": true,
      "class_weights": true,
      "directory": "R3_augmentation",
      "technique": "Fine-tuning + class weights + mild train-only augmentation"
    }
  },
  "seed": 42,
  "selection": {
    "close_tolerance": 0.005,
    "primary_metric": "validation_macro_f1",
    "require_leaf_spot_not_collapsed": true
  },
  "smoke_test": {
    "epochs": 1,
    "train_per_class": 4,
    "validation_per_class": 2
  },
  "source": {
    "checkpoint": "ai_model/experiments/eggplant_efficientnetb0_d8_lite/runs/P3/best_model.keras",
    "checkpoint_sha256": "c30bfc8839ba91bb4ced173375aeb2b95098e57d4eea32a326e4f23ec1bb0496",
    "d8_metrics": "ai_model/experiments/eggplant_efficientnetb0_d8_lite/runs/P3/metrics.json",
    "preprocessing_config": "ai_model/configs/eggplant_preprocessing.json",
    "preprocessing_variant": "P3"
  },
  "training": {
    "batch_size": 32,
    "early_stopping_monitor": "val_loss",
    "early_stopping_patience": 5,
    "learning_rate": 1e-05,
    "loss": "sparse_categorical_crossentropy",
    "max_epochs": 20,
    "optimizer": "Adam",
    "restore_best_weights": true,
    "shuffle_train": true
  }
}
