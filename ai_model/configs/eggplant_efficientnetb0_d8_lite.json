{
  "config_version": "1.0",
  "experiment_id": "eggplant_efficientnetb0_d8_lite",
  "seed": 42,
  "classes": ["healthy", "leaf_spot", "mosaic_virus"],
  "data": {
    "manifest": "dataset/metadata/eggplant_split_manifest.csv",
    "split_root": "dataset/split/eggplant",
    "train_split": "train",
    "validation_split": "val",
    "expected_counts": {"train": 2425, "val": 324, "test": 0},
    "image_size": [224, 224],
    "channels": 3
  },
  "preprocessing": {
    "config": "ai_model/configs/eggplant_preprocessing.json",
    "variants": ["P0", "P3"],
    "model_normalization": "keras_efficientnet_internal_rescaling",
    "input_dtype": "float32",
    "input_value_range": [0, 255],
    "augmentation_enabled": false,
    "class_balancing_enabled": false
  },
  "model": {
    "architecture": "EfficientNetB0",
    "weights": "imagenet",
    "include_top": false,
    "backbone_trainable": false,
    "pooling": "global_average",
    "dropout_rate": 0.2,
    "output_activation": "softmax"
  },
  "training": {
    "batch_size": 32,
    "max_epochs": 30,
    "optimizer": "Adam",
    "learning_rate": 0.001,
    "loss": "sparse_categorical_crossentropy",
    "early_stopping_monitor": "val_loss",
    "early_stopping_patience": 5,
    "restore_best_weights": true,
    "shuffle_train": true
  },
  "selection": {
    "primary_metric": "validation_macro_f1",
    "tie_breaker_threshold": 0.005,
    "p2_trigger_if_p3_leaf_spot_recall_below_p0": true
  },
  "d7_reference": {
    "comparison_csv": "ai_model/experiments/eggplant_mobilenetv2_d7/comparison/preprocessing_comparison.csv",
    "P0": {"validation_accuracy": 0.7006172839506173, "validation_macro_f1": 0.6395911705895311, "leaf_spot_recall": 0.36, "best_epoch": 11},
    "P3": {"validation_accuracy": 0.7098765432098766, "validation_macro_f1": 0.6627456506915528, "leaf_spot_recall": 0.44, "best_epoch": 13}
  },
  "smoke_test": {
    "train_per_class": 4,
    "validation_per_class": 2,
    "epochs": 1
  }
}
